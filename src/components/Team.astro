---
import { getCollection, getEntry, render } from 'astro:content';

const { data: section } = await getEntry('homepage', 'teamSection');
const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---
<section class="team" id="team">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow-line"><span class="dash"></span> {section.eyebrow}</div>
      <h2>{section.title}</h2>
    </div>
    <div class="team-grid">
      {members.map(async (member) => {
        const { Content } = await render(member);
        return (
          <div class="member">
            <div class:list={["member-photo", member.data.photo && "has-photo"]}>
              {member.data.photo ? (
                <img src={member.data.photo} alt={member.data.name} class="photo-img" />
              ) : (
                <span class="ph-label">photo</span>
              )}
            </div>
            <h3>{member.data.name}</h3>
            <p class="role">{member.data.role}</p>
            <div class="bio"><Content /></div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .team { padding: clamp(56px, 7vw, 88px) 0; }
  .section-head { max-width: 62ch; margin-bottom: clamp(32px, 4vw, 48px); }
  .section-head h2 { font-size: clamp(26px, 3vw, 34px); }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 28px;
  }
  .member-photo {
    aspect-ratio: 1;
    border-radius: 6px;
    background: repeating-linear-gradient(135deg, var(--panel), var(--panel) 10px, var(--oat-deep) 10px, var(--oat-deep) 20px);
    border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .member-photo.has-photo {
    background: none;
  }
  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .member-photo .ph-label { font-size: 12px; color: var(--charcoal); }
  .member h3 { font-size: 18px; }
  .member .role { margin-top: 4px; font-size: 13.5px; color: var(--orange-deep); font-weight: 500; }
  .member .bio { margin-top: 8px; font-size: 14px; color: var(--charcoal); }
  .member .bio :global(p) { margin: 0; }
</style>
