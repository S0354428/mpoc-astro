---
interface Item { title: string; body: string; }
interface Props {
  items: Item[];
  columns?: 2 | 3;
}
const { items, columns = 2 } = Astro.props;
---
<div class:list={["card-grid", columns === 3 && "cols-3"]}>
  {items.map((item) => (
    <div class="card">
      <h3>{item.title}</h3>
      <p>{item.body}</p>
    </div>
  ))}
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .card-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .card { background: var(--panel); padding: clamp(24px, 3vw, 32px); }
  .card h3 { font-size: 19px; font-weight: 600; }
  .card p { margin-top: 10px; color: var(--charcoal); font-size: 14.5px; }
  @media (max-width: 860px) {
    .card-grid, .card-grid.cols-3 { grid-template-columns: 1fr; }
  }
</style>
