---
import { getEntry } from 'astro:content';
const { data: stats } = await getEntry('homepage', 'stats');
// stats.yaml is a plain list, so the entry's data IS the array
---
<section class="stats">
  <div class="wrap stats-grid">
    {(stats as { number: string; label: string }[]).map((s) => (
      <div class="stat">
        <span class="num">{s.number}</span>
        <span class="lbl">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats { background: var(--ink); color: var(--oat); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: clamp(34px, 5vw, 50px) 0;
  }
  .stat {
    text-align: left;
    padding: 0 clamp(10px, 2vw, 28px);
    border-left: 1px solid rgba(242,238,228,0.16);
  }
  .stat:first-child { border-left: none; }
  .stat .num {
    font-family: 'Crimson Text', serif;
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 42px);
    color: var(--orange);
    display: block;
  }
  .stat .lbl {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--oat-deep);
    opacity: 0.85;
    display: block;
  }
  @media (max-width: 860px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); row-gap: 24px; }
    .stat:nth-child(3) { border-left: none; }
  }
</style>
